# Server
PORT=3000

# PostgreSQL — either the individual fields below, or DATABASE_URL (preferred for Neon/Supabase).
# If DATABASE_URL is set, DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME are ignored.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=brainbox
# DATABASE_URL=postgresql://user:pass@host:5432/db?sslmode=require
# DB_SSL=true            # required for Neon/Supabase (they reject plain connections)
# DB_SYNCHRONIZE=true    # auto-sync schema from entities — set to false in production

# Redis — either host/port below, or REDIS_URL (required for Upstash, which is TLS-only rediss://)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_URL=rediss://default:pass@lyrebird-xxx.upstash.io:6379

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-nano-30b-a3b:free
OPENROUTER_FALLBACK_MODEL=google/gemma-4-26b-a4b-it:free

# Public base URL used to build Telegram webhook URLs
# e.g. https://your-ngrok-url.ngrok-free.app (no trailing slash)
PUBLIC_BASE_URL=https://youth-quizzes-players-municipality.trycloudflare.com/

# Optional: if set, onboarding endpoints require an X-Admin-Key header
ADMIN_API_KEY=

# Optional: session context budget in tokens (default 3000); summaries roll old messages out
SESSION_TOKEN_BUDGET=3000

# Required: key used to encrypt tenant credentials (auth headers, bot tokens, OpenAPI specs) at rest
# Any string works; a 64-char hex (32 random bytes) is recommended
DATA_ENCRYPTION_KEY=
